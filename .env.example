# Copy this file to .env (which is gitignored) and fill in your machine's paths.
# .env is sourced by run.sh and retrieval_launch*.sh, so these never get committed.

# Local path to the base model used for actor/critic/rollout.
BASE_MODEL=/path/to/your/base-model

# Ray temp/spill dir — keep it on a disk with plenty of free space (not root).
RAY_TEMP_DIR=/path/to/ray_tmp

# Where the FAISS index + corpus live. Required for docker-compose (it is mounted into
# the retriever container at the same path). Defaults to <repo>/index_document on bare metal.
INDEX_DIR=/path/to/Search-R1/index_document

# ---------------------------------------------------------------------------
# docker-compose only (ignored on bare metal). See docker/README.md.
# ---------------------------------------------------------------------------
# Retriever server port (shared by both services).
RETRIEVER_PORT=8002
# Retriever backend inside the container: faiss_cpu (default, stable on H200) | torch_gpu | faiss_gpu
RETRIEVER_BACKEND=faiss_cpu
# Optional: pin the retriever's encoder to a specific physical GPU index, e.g. 0
# FORCE_RETRIEVER_GPUS=0
# Host dir for the HuggingFace cache (so the e5 model is not re-downloaded each run).
HF_HOME=./.hf-cache
# Optional: Weights & Biases API key passed into the training container.
# WANDB_API_KEY=
